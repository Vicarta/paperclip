{
  "name": "@paperclipai/plugin-exa-agent-tools",
  "version": "0.1.0",
  "description": "Paperclip agent tools backed by Exa MCP for web search, crawling, and code-context lookup",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "prebuild": "node ../../../../scripts/ensure-plugin-build-deps.mjs",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk build && tsc --noEmit",
    "test": "pnpm --filter @paperclipai/plugin-sdk build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
