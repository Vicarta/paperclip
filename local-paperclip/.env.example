DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Optional: enables /api/auth/request-password-reset email delivery.
# PAPERCLIP_AUTH_PASSWORD_RESET_RESEND_API_KEY=re_...
# PAPERCLIP_AUTH_PASSWORD_RESET_FROM_EMAIL=Paperclip <paperclip@example.com>
# PAPERCLIP_AUTH_PASSWORD_RESET_REPLY_TO=support@example.com
# PAPERCLIP_AUTH_PASSWORD_RESET_SUBJECT=Reset your Paperclip password

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
