FROM node:lts-trixie-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git jq ripgrep \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY . .
RUN pnpm install --prod=false --no-frozen-lockfile
RUN pnpm --filter @paperclipai/ui build
RUN pnpm --filter @paperclipai/plugin-sdk build
RUN for plugin in \
    packages/plugins/plugin-dataforseo-agent-tools \
    packages/plugins/plugin-diskinternals-bigquery-growth \
    packages/plugins/plugin-crawlobserver-agent-tools \
    packages/plugins/plugin-exa-agent-tools \
    packages/plugins/plugin-gsc-bing-ga4-mcp-agent-tools \
    packages/plugins/plugin-payload-cms-agent-tools \
    packages/plugins/plugin-perfex-crm-agent-tools \
    packages/plugins/plugin-search-console-mcp-agent-tools \
    packages/plugins/plugin-semantic-core-mcp-agent-tools \
    packages/plugins/plugin-seo-performance-loop \
    packages/plugins/plugin-serper-agent-tools \
    packages/plugins/plugin-winning-structure-mcp-agent-tools \
    packages/plugins/plugin-telegram; \
  do (cd "$plugin" && pnpm build); done
RUN pnpm --filter @paperclipai/server build
RUN test -f server/dist/index.js || (echo "ERROR: server build output missing" && exit 1)

FROM base AS production
WORKDIR /app
COPY --chown=node:node --from=build /app /app
RUN ln -s /app/node_modules /node_modules
RUN npm install --global --omit=dev @anthropic-ai/claude-code@latest @openai/codex@latest opencode-ai \
  && mkdir -p /paperclip \
  && chown node:node /paperclip

ENV NODE_ENV=production \
  HOME=/paperclip \
  HOST=0.0.0.0 \
  PORT=3100 \
  SERVE_UI=true \
  PAPERCLIP_HOME=/paperclip \
  PAPERCLIP_INSTANCE_ID=default \
  PAPERCLIP_CONFIG=/paperclip/instances/default/config.json \
  PAPERCLIP_DEPLOYMENT_MODE=authenticated \
  PAPERCLIP_DEPLOYMENT_EXPOSURE=private

VOLUME ["/paperclip"]
EXPOSE 3100

USER node
CMD ["node", "--import", "./server/node_modules/tsx/dist/loader.mjs", "server/dist/index.js"]
