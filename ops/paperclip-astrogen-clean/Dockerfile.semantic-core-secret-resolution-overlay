# syntax=docker/dockerfile:1.20
ARG BASE_IMAGE=paperclip-app:v2026.626.0-vicarta.103-child-result-projection-20260719
FROM ${BASE_IMAGE}

USER root
COPY --chown=node:node packages/plugins/plugin-semantic-core-mcp-agent-tools/ /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/
RUN test -f /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/dist/worker.js \
  && grep -q 'createPerExecutionSecretResolver' /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/dist/semantic-core-mcp-client.js \
  && node -e "const p=require('/app/packages/plugins/plugin-semantic-core-mcp-agent-tools/package.json'); if(p.version!=='0.3.12') process.exit(1)" \
  && command -v psql >/dev/null 2>&1

# Keep secret resolution scoped to one compound plugin execution while retaining
# the server-wide anti-enumeration rate limit for independent attempts.
