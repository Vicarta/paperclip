# syntax=docker/dockerfile:1.20
ARG BASE_IMAGE=paperclip-app:v2026.626.0-vicarta.118-child-result-projection-v2-20260720
FROM ${BASE_IMAGE}

USER root
COPY --chown=node:node semantic-core/package.json /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/package.json
COPY --chown=node:node semantic-core/dist/ /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/dist/
RUN test -f /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/dist/worker.js \
  && grep -q 'Semantic Core trend validation requires 1-50 explicit candidate_keywords' /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/dist/semantic-core-mcp-client.js \
  && grep -q 'delete normalizedPayload.keywords' /app/packages/plugins/plugin-semantic-core-mcp-agent-tools/dist/semantic-core-mcp-client.js \
  && node -e "const p=require('/app/packages/plugins/plugin-semantic-core-mcp-agent-tools/package.json'); if(p.version!=='0.3.13') process.exit(1)"

# Guard trend validation from silently falling back to semantic-core inventory:
# legacy `keywords` aliases are normalized to bounded `candidate_keywords`, and
# trend validation without explicit candidates or on core_product_intent is refused.
